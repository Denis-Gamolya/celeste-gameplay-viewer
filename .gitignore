# Local Python environments and dependency copies.
.venv/
venv/
env/
.install-test/
__pycache__/
*.py[cod]
*.egg-info/

# Generated map browsers, snapshots, renders, and build output.
outputs/
previews/
build/
dist/
*.log

# Celeste maps and extracted game artwork belong on the user's machine.
*.bin
*.data
celeste_gameplay_viewer/assets/sprites/*
